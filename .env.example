# Configurações do WebScrapping Farmácias
APP_NAME="WebScrapping Farmácias API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Scraping Settings
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_CONCURRENCY=5
# Total de tentativas por farmácia (1 desliga o retry). Só falhas técnicas são
# repetidas: "não encontrado" e "bloqueado" são respostas da loja e saem na
# primeira tentativa.
SCRAPER_RETRY_ATTEMPTS=2
SCRAPER_RETRY_BASE_DELAY=0.5
SCRAPER_RETRY_MAX_DELAY=4.0

# Banco de dados (PostgreSQL via Docker Compose)
POSTGRES_DB="webscrapping_farmacias"
POSTGRES_USER="webscrapping"
POSTGRES_PASSWORD="webscrapping_local"
DATABASE_URL="postgresql+asyncpg://webscrapping:webscrapping_local@localhost:5432/webscrapping_farmacias"
DATABASE_ECHO=False

# Pastas
CLIENTS_DIR="./Clientes"
REPORTS_DIR="./reports"
